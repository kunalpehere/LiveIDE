# MongoDB used by Prisma. Required outside explicit mock development mode.
DATABASE_URL="mongodb://localhost:27017/liveide"

# Development only. When true, DATABASE_URL is ignored and data is in-memory.
ENABLE_MOCK_DB="false"

# NextAuth / Auth.js. Generate a random secret; production requires at least
# 32 characters and rejects placeholders. Both aliases must match if set.
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Real-time CRDT collaboration. Keep the secret server-only and identical for
# the Next.js app and collaboration server. It must differ from AUTH_SECRET.
# Leave the URL and secret empty to disable collaboration. Production URLs
# must use wss:// for the browser and https:// for the application.
NEXT_PUBLIC_COLLABORATION_URL=""
COLLABORATION_SECRET=""
COLLABORATION_HOST="127.0.0.1"
COLLABORATION_PORT="1234"
COLLABORATION_APP_URL=""
# Optional locally; required when multiple collaboration-server instances run.
REDIS_URL=""
COLLABORATION_INSTANCE_ID=""

# Configure at least one OAuth provider for sign-in.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Day 20: separate GitHub OAuth app for repository access. Register callback:
# <GITHUB_CONNECTION_ORIGIN>/api/github/callback (no trailing slash in origin).
# Leave these empty to disable connection while keeping GitHub sign-in working.
GITHUB_CONNECTION_CLIENT_ID=""
GITHUB_CONNECTION_CLIENT_SECRET=""
GITHUB_CONNECTION_ORIGIN=""
# Independent random 32-byte key, encoded as 64 hex characters. Keep server-only.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_CONNECTION_ENCRYPTION_KEY=""

# AI is opt-in. Set this to true only after the provider below is running.
AI_ENABLED="false"

# Local AI service used by chat and manual inline completions.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="codellama:latest"

# Stage 5 AI gateway configuration.
AI_PROVIDER="ollama"
AI_PROVIDER_URL="http://localhost:11434"
AI_MODEL="codellama:latest"
AI_TIMEOUT_MS="20000"
